{
  "deal_type": "revolver",
  "categories": [
    {
      "name": "Organizational & KYC Documents",
      "scope": "per_entity",
      "docs": [
        {"name": "Formation Certificate", "subfolder": "Formation Certificates"},
        {"name": "Operating Agreement / LPA", "subfolder": "Operating Agreements - LPAs"},
        {"name": "Good Standing Certificate", "subfolder": "Good Standing Certificates"},
        {"name": "W-9", "subfolder": "W-9s"},
        {"name": "Beneficial Ownership Certification", "subfolder": "Beneficial Ownership Certifications"}
      ]
    },
    {
      "name": "Principal Loan Documents",
      "scope": "per_deal",
      "drafts_and_executed": true,
      "docs": [
        {"name": "Credit Agreement", "subfolder": "Credit Agreement"},
        {"name": "Notes", "subfolder": "Notes"},
        {"name": "Subsidiary Guaranties", "subfolder": "Subsidiary Guaranties"},
        {"name": "Closing Certificate", "subfolder": "Closing Certificate"},
        {"name": "Legal Opinion", "subfolder": "Legal Opinion"},
        {"name": "Solvency Certificate", "subfolder": "Solvency Certificate"},
        {"name": "Officer's Certificate", "subfolder": "Officer's Certificate"},
        {"name": "Board Resolutions", "subfolder": "Board Resolutions"},
        {"name": "Borrowing Base Certificate", "subfolder": "Borrowing Base Certificate"},
        {"name": "Fee Letters", "subfolder": "Fee Letters"},
        {"name": "Deposit Account Control Agreements", "subfolder": "Deposit Account Control Agreements"},
        {"name": "LC Documentation", "subfolder": "LC Documentation"}
      ]
    },
    {
      "name": "Due Diligence",
      "scope": "per_deal",
      "docs": [
        {"name": "Audited Financial Statements", "subfolder": "Audited Financial Statements"},
        {"name": "Projections", "subfolder": "Projections"},
        {"name": "Compliance Certificate", "subfolder": "Compliance Certificate"}
      ]
    }
  ],
  "conditional": [
    {
      "condition": {
        "facility_feature": "asset_based"
      },
      "categories": [
        {
          "name": "Security & Collateral Documents",
          "scope": "per_deal",
          "docs": [
            {"name": "Field Exam Report", "subfolder": "Field Exam Report"},
            {"name": "Collateral Schedules", "subfolder": "Collateral Schedules"},
            {"name": "UCC-1 Financing Statements", "subfolder": "UCC-1 Financing Statements"}
          ]
        }
      ]
    }
  ]
}
